{
  "version": 1,
  "requiredFamilies": [
    "shell", "scripting", "javascript-package", "python-package",
    "source-control", "rust", "native", "go", "jvm", "dotnet",
    "build", "test", "search-text", "archive-copy", "network",
    "database", "browser", "container", "signing"
  ],
  "scenarios": [
    { "id": "cmd", "family": "shell", "requiredOnHost": true, "commands": ["cmd"], "terminal": "pipes", "arguments": ["/d", "/s", "/c", "mkdir cmd && echo cmd>cmd\\result.txt"], "expectedFiles": ["cmd/result.txt"] },
    { "id": "powershell7", "family": "shell", "requiredOnHost": true, "commands": ["pwsh"], "terminal": "pseudo-console", "files": { "run.ps1": "New-Item -ItemType Directory -Force ps | Out-Null\nSet-Content -Path ps/result.txt -Value powershell\nWrite-Output POWERSHELL_OK\n" }, "arguments": ["-NoLogo", "-NoProfile", "-File", "{Workspace}\\run.ps1"], "stdoutContains": ["POWERSHELL_OK"], "expectedFiles": ["ps/result.txt"], "environment": { "DOTNET_EnableDiagnostics": "0" } },
    { "id": "windows-powershell", "family": "shell", "requiredOnHost": true, "commands": ["powershell"], "terminal": "pseudo-console", "files": { "run.ps1": "New-Item -ItemType Directory -Force windows-ps | Out-Null\nSet-Content -Path windows-ps/result.txt -Value powershell\nWrite-Output WINDOWS_PS_OK\n" }, "arguments": ["-NoLogo", "-NoProfile", "-File", "{Workspace}\\run.ps1"], "stdoutContains": ["WINDOWS_PS_OK"], "expectedFiles": ["windows-ps/result.txt"] },
    { "id": "git-bash", "family": "shell", "requiredOnHost": true, "commands": ["bash"], "candidates": ["{ProgramFiles}\\Git\\bin\\bash.exe"], "terminal": "pipes", "namedPipes": "isolated", "readOnly": ["{ProgramFiles}\\Git"], "arguments": ["-c", "mkdir bash && printf bash > bash/result.txt"], "expectedFiles": ["bash/result.txt"] },
    { "id": "git-sh", "family": "shell", "requiredOnHost": true, "commands": ["dash", "sh"], "candidates": ["{ProgramFiles}\\Git\\usr\\bin\\dash.exe"], "terminal": "pipes", "namedPipes": "isolated", "readOnly": ["{ProgramFiles}\\Git"], "arguments": ["-c", "mkdir sh && printf sh > sh/result.txt"], "expectedFiles": ["sh/result.txt"], "environment": { "CHERE_INVOKING": "1", "MSYS2_PATH_TYPE": "inherit", "PATH": "{ProgramFiles}\\Git\\usr\\bin;{SystemRoot}\\System32" } },

    { "id": "python", "family": "scripting", "requiredOnHost": true, "commands": ["python"], "terminal": "pipes", "arguments": ["-I", "-c", "import pathlib; pathlib.Path('python.txt').write_text('python'); print('PYTHON_OK')"], "stdoutContains": ["PYTHON_OK"], "expectedFiles": ["python.txt"] },
    { "id": "node", "family": "scripting", "requiredOnHost": true, "commands": ["node"], "terminal": "pipes", "arguments": ["-e", "require('fs').writeFileSync('node.txt','node');console.log('NODE_OK')"], "stdoutContains": ["NODE_OK"], "expectedFiles": ["node.txt"] },
    { "id": "ruby", "family": "scripting", "requiredOnHost": false, "commands": ["ruby"], "terminal": "pipes" },
    { "id": "php", "family": "scripting", "requiredOnHost": false, "commands": ["php"], "terminal": "pipes" },
    { "id": "perl", "family": "scripting", "requiredOnHost": false, "commands": ["perl"], "terminal": "pipes" },
    { "id": "deno", "family": "scripting", "requiredOnHost": false, "commands": ["deno"], "terminal": "pipes" },
    { "id": "bun", "family": "scripting", "requiredOnHost": false, "commands": ["bun"], "terminal": "pipes" },

    { "id": "npm", "family": "javascript-package", "requiredOnHost": true, "commands": ["npm"], "candidates": ["{ProgramFiles}\\nodejs\\npm.cmd"], "terminal": "pipes", "readOnly": ["{ProgramFiles}\\nodejs"], "files": { "package.json": "{\"private\":true,\"scripts\":{\"verify\":\"node verify.js\"}}", "verify.js": "require('fs').writeFileSync('npm.txt','npm');console.log('NPM_OK')" }, "arguments": ["--offline", "--no-audit", "--no-fund", "run", "verify"], "stdoutContains": ["NPM_OK"], "expectedFiles": ["npm.txt"], "environment": { "npm_config_cache": "{Workspace}\\.npm-cache" } },
    { "id": "npx", "family": "javascript-package", "requiredOnHost": true, "commands": ["npx"], "candidates": ["{ProgramFiles}\\nodejs\\npx.cmd"], "terminal": "pipes", "readOnly": ["{ProgramFiles}\\nodejs"], "arguments": ["--version"] },
    { "id": "corepack", "family": "javascript-package", "requiredOnHost": true, "commands": ["corepack"], "candidates": ["{ProgramFiles}\\nodejs\\corepack.cmd"], "terminal": "pipes", "readOnly": ["{ProgramFiles}\\nodejs"], "arguments": ["--version"] },
    { "id": "pnpm", "family": "javascript-package", "requiredOnHost": true, "commands": ["pnpm"], "terminal": "pipes", "readOnly": ["{ToolDirectory}", "{ToolParentRoot}\\node", "{ProgramFiles}\\nodejs"], "arguments": ["--version"] },
    { "id": "yarn", "family": "javascript-package", "requiredOnHost": false, "commands": ["yarn"], "terminal": "pipes", "readOnly": ["{ToolRoot}", "{ProgramFiles}\\nodejs"], "files": { "package.json": "{\"private\":true,\"scripts\":{\"verify\":\"node verify.js\"}}", "verify.js": "require('fs').writeFileSync('yarn.txt','yarn');console.log('YARN_OK')" }, "arguments": ["--offline", "--non-interactive", "run", "verify"], "stdoutContains": ["YARN_OK"], "expectedFiles": ["yarn.txt"], "environment": { "YARN_CACHE_FOLDER": "{Workspace}\\.yarn-cache" } },

    { "id": "pip", "family": "python-package", "requiredOnHost": true, "commands": ["python"], "terminal": "pipes", "arguments": ["-m", "pip", "--version"], "stdoutContains": ["pip"] },
    { "id": "uv", "family": "python-package", "requiredOnHost": false, "commands": ["uv"], "terminal": "pipes", "readOnly": ["{ToolRoot}", "{PythonRoot}"], "files": { "pyproject.toml": "[project]\nname = \"agent-uv\"\nversion = \"0.1.0\"\nrequires-python = \">=3.12\"\n" }, "arguments": ["--no-config", "lock", "--offline", "--no-cache", "--python", "{PythonRoot}\\python.exe"], "expectedFiles": ["uv.lock"], "environment": { "UV_CACHE_DIR": "{Workspace}\\.uv-cache" } },
    { "id": "poetry", "family": "python-package", "requiredOnHost": false, "commands": ["poetry"], "terminal": "pipes", "readOnly": ["{ToolRoot}", "{PythonRoot}"], "files": { "pyproject.toml": "[project]\nname = \"agent-poetry\"\nversion = \"0.1.0\"\ndescription = \"Agent fixture\"\nauthors = [{name = \"Agent\"}]\nrequires-python = \">=3.12\"\n" }, "arguments": ["check", "--no-cache"], "stdoutContains": ["All set!"], "environment": { "POETRY_CACHE_DIR": "{Workspace}\\.poetry-cache", "POETRY_CONFIG_DIR": "{Workspace}\\.poetry-config", "POETRY_DATA_DIR": "{Workspace}\\.poetry-data", "POETRY_VIRTUALENVS_CREATE": "false", "PYTHON_KEYRING_BACKEND": "keyring.backends.null.Keyring", "PYTHONDONTWRITEBYTECODE": "1" } },

    { "id": "git", "family": "source-control", "requiredOnHost": true, "commands": ["git"], "terminal": "pipes", "arguments": ["init", "--quiet"], "expectedFiles": [".git"], "environment": { "GIT_CONFIG_GLOBAL": "NUL", "GIT_CONFIG_SYSTEM": "NUL", "GIT_TEMPLATE_DIR": "{Workspace}\\.git-template", "GIT_ATTR_NOSYSTEM": "1" } },
    { "id": "gh", "family": "source-control", "requiredOnHost": false, "commands": ["gh"], "terminal": "pipes" },

    { "id": "cargo", "family": "rust", "requiredOnHost": true, "commands": ["cargo"], "terminal": "pipes", "arguments": ["--version"] },
    { "id": "rustc", "family": "rust", "requiredOnHost": true, "commands": ["rustc"], "terminal": "pipes", "arguments": ["--version"] },
    { "id": "rustfmt", "family": "rust", "requiredOnHost": true, "commands": ["rustfmt"], "terminal": "pipes", "arguments": ["--version"] },
    { "id": "clippy", "family": "rust", "requiredOnHost": true, "commands": ["clippy-driver"], "terminal": "pipes", "arguments": ["--version"] },

    { "id": "gcc", "family": "native", "requiredOnHost": false, "commands": ["gcc"], "terminal": "pipes" },
    { "id": "clang", "family": "native", "requiredOnHost": false, "commands": ["clang"], "terminal": "pipes" },
    { "id": "msvc", "family": "native", "requiredOnHost": true, "commands": ["cl"], "candidates": ["{VisualStudio}\\VC\\Tools\\MSVC\\*\\bin\\Hostx64\\x64\\cl.exe"], "terminal": "pipes", "arguments": ["/nologo"], "acceptedExitCodes": [0, 2] },

    { "id": "go", "family": "go", "requiredOnHost": true, "commands": ["go"], "candidates": ["{ProgramFiles}\\Go\\bin\\go.exe"], "terminal": "pipes", "namedPipes": "isolated", "readOnly": ["{ToolRoot}"], "files": { "go.mod": "module agenttool\n\ngo 1.26\n", "main.go": "package main\nimport (\"fmt\";\"os\")\nfunc main(){os.WriteFile(\"go.txt\",[]byte(\"go\"),0600);fmt.Println(\"GO_OK\")}\n" }, "arguments": ["run", "."], "stdoutContains": ["GO_OK"], "expectedFiles": ["go.txt"], "environment": { "GOCACHE": "{Workspace}\\.go-cache", "GOPATH": "{Workspace}\\.go-path", "GOMODCACHE": "{Workspace}\\.go-mod-cache", "GOTOOLCHAIN": "local", "GOPROXY": "off" } },
    { "id": "java", "family": "jvm", "requiredOnHost": false, "commands": ["java"], "terminal": "pipes" },
    { "id": "javac", "family": "jvm", "requiredOnHost": false, "commands": ["javac"], "terminal": "pipes" },
    { "id": "maven", "family": "jvm", "requiredOnHost": false, "commands": ["mvn"], "terminal": "pipes" },
    { "id": "gradle", "family": "jvm", "requiredOnHost": false, "commands": ["gradle"], "terminal": "pipes" },
    { "id": "dotnet", "family": "dotnet", "requiredOnHost": false, "commands": ["dotnet"], "terminal": "pipes" },

    { "id": "cmake", "family": "build", "requiredOnHost": true, "commands": ["cmake"], "candidates": ["{VisualStudio}\\Common7\\IDE\\CommonExtensions\\Microsoft\\CMake\\CMake\\bin\\cmake.exe"], "terminal": "pipes", "readOnly": ["{VisualStudio}"], "arguments": ["-E", "touch", "{Workspace}\\cmake.txt"], "expectedFiles": ["cmake.txt"] },
    { "id": "ninja", "family": "build", "requiredOnHost": true, "commands": ["ninja"], "candidates": ["{VisualStudio}\\Common7\\IDE\\CommonExtensions\\Microsoft\\CMake\\Ninja\\ninja.exe"], "terminal": "pipes", "namedPipes": "isolated", "readOnly": ["{VisualStudio}"], "files": { "build.ninja": "rule generate\n  command = cmd /d /c echo ninja>ninja.txt\nbuild ninja.txt: generate\ndefault ninja.txt\n" }, "arguments": ["-f", "{Workspace}\\build.ninja"], "expectedFiles": ["ninja.txt"] },
    { "id": "msbuild", "family": "build", "requiredOnHost": true, "commands": ["msbuild"], "candidates": ["{VisualStudio}\\MSBuild\\Current\\Bin\\amd64\\MSBuild.exe"], "terminal": "pipes", "readOnly": ["{VisualStudio}"], "files": { "agent.proj": "<Project xmlns=\"http://schemas.microsoft.com/developer/msbuild/2003\"><Target Name=\"Build\"><WriteLinesToFile File=\"msbuild.txt\" Lines=\"msbuild\" Overwrite=\"true\"/><Message Text=\"MSBUILD_OK\" Importance=\"high\"/></Target></Project>" }, "arguments": ["{Workspace}\\agent.proj", "/nologo", "/v:minimal", "/m:1", "/nr:false"], "stdoutContains": ["MSBUILD_OK"], "expectedFiles": ["msbuild.txt"], "environment": { "MSBUILDDISABLENODEREUSE": "1", "DOTNET_EnableDiagnostics": "0" } },
    { "id": "make", "family": "build", "requiredOnHost": false, "commands": ["make"], "terminal": "pipes" },

    { "id": "pytest", "family": "test", "requiredOnHost": false, "commands": ["pytest"], "terminal": "pipes", "readOnly": ["{ToolRoot}", "{PythonRoot}"], "files": { "test_agent.py": "from pathlib import Path\n\ndef test_workspace_write():\n    Path('pytest.txt').write_text('pytest', encoding='utf-8')\n" }, "arguments": ["-q", "--disable-plugin-autoload", "{Workspace}\\test_agent.py"], "stdoutContains": ["1 passed"], "expectedFiles": ["pytest.txt"], "environment": { "PYTEST_DISABLE_PLUGIN_AUTOLOAD": "1" } },
    { "id": "jest", "family": "test", "requiredOnHost": false, "commands": ["jest"], "terminal": "pipes", "readOnly": ["{ToolRoot}", "{ProgramFiles}\\nodejs"], "files": { "agent.test.js": "const fs=require('fs');test('workspace write',()=>{fs.writeFileSync('jest.txt','jest');expect(2+2).toBe(4)})" }, "arguments": ["--runInBand", "--no-cache", "{Workspace}\\agent.test.js"], "stdoutContains": ["1 passed"], "expectedFiles": ["jest.txt"], "environment": { "NODE_PATH": "{ToolRoot}" } },
    { "id": "playwright", "family": "browser", "requiredOnHost": false, "commands": ["playwright"], "terminal": "pipes", "namedPipes": "isolated", "readOnly": ["{ToolRoot}", "{ProgramFiles}\\nodejs", "{BrowserRoot}"], "files": { "agent.spec.js": "const fs=require('fs');const {test,expect,chromium}=require('@playwright/test');test('browser DOM',async()=>{const browser=await chromium.launch({headless:true,executablePath:process.env.BOLT_TEST_BROWSER});const page=await browser.newPage();await page.setContent('<main id=ready>browser-ok</main>');await expect(page.locator('#ready')).toHaveText('browser-ok');fs.writeFileSync('playwright.txt','playwright');await browser.close()})" }, "arguments": ["test", "{Workspace}\\agent.spec.js", "--workers=1", "--reporter=line"], "stdoutContains": ["1 passed"], "expectedFiles": ["playwright.txt"], "environment": { "NODE_PATH": "{ToolRoot}", "BOLT_TEST_BROWSER": "{BrowserExecutable}", "PLAYWRIGHT_BROWSERS_PATH": "0" } },

    { "id": "rg", "family": "search-text", "requiredOnHost": true, "commands": ["rg"], "terminal": "pipes", "files": { "input.txt": "alpha\nbeta\n" }, "arguments": ["alpha", "{Workspace}\\input.txt"], "stdoutContains": ["alpha"] },
    { "id": "sed", "family": "search-text", "requiredOnHost": true, "commands": ["sed"], "candidates": ["{ProgramFiles}\\Git\\usr\\bin\\sed.exe"], "terminal": "pipes", "namedPipes": "isolated", "files": { "input.txt": "alpha\n" }, "arguments": ["s/alpha/sed/", "{Workspace}\\input.txt"], "stdoutContains": ["sed"] },
    { "id": "awk", "family": "search-text", "requiredOnHost": true, "commands": ["awk"], "candidates": ["{ProgramFiles}\\Git\\usr\\bin\\awk.exe"], "terminal": "pipes", "namedPipes": "isolated", "files": { "input.txt": "alpha beta\n" }, "arguments": ["{print $2}", "{Workspace}\\input.txt"], "stdoutContains": ["beta"] },
    { "id": "jq", "family": "search-text", "requiredOnHost": false, "commands": ["jq"], "terminal": "pipes" },
    { "id": "fd", "family": "search-text", "requiredOnHost": false, "commands": ["fd"], "terminal": "pipes" },

    { "id": "tar", "family": "archive-copy", "requiredOnHost": true, "commands": ["tar"], "terminal": "pipes", "files": { "input.txt": "archive\n" }, "arguments": ["-cf", "{Workspace}\\output.tar", "-C", "{Workspace}", "input.txt"], "expectedFiles": ["output.tar"] },
    { "id": "robocopy", "family": "archive-copy", "requiredOnHost": true, "commands": ["robocopy"], "terminal": "pipes", "files": { "source/input.txt": "copy\n" }, "arguments": ["{Workspace}\\source", "{Workspace}\\destination", "input.txt", "/NJH", "/NJS", "/NDL", "/NFL", "/R:0", "/W:0"], "acceptedExitCodes": [0, 1], "expectedFiles": ["destination/input.txt"] },
    { "id": "sevenzip", "family": "archive-copy", "requiredOnHost": false, "commands": ["7z"], "terminal": "pipes" },

    { "id": "curl", "family": "network", "requiredOnHost": true, "commands": ["curl"], "terminal": "pipes", "arguments": ["--version"], "stdoutContains": ["curl"] },
    { "id": "wget", "family": "network", "requiredOnHost": false, "commands": ["wget"], "terminal": "pipes" },

    { "id": "sqlite", "family": "database", "requiredOnHost": false, "commands": ["sqlite3"], "terminal": "pipes" },
    { "id": "psql", "family": "database", "requiredOnHost": false, "commands": ["psql"], "terminal": "pipes" },
    { "id": "mysql", "family": "database", "requiredOnHost": false, "commands": ["mysql"], "terminal": "pipes" },

    { "id": "docker", "family": "container", "requiredOnHost": false, "commands": ["docker"], "terminal": "pipes", "privileged": true },
    { "id": "podman", "family": "container", "requiredOnHost": false, "commands": ["podman"], "terminal": "pipes", "privileged": true },
    { "id": "signtool", "family": "signing", "requiredOnHost": false, "commands": ["signtool"], "terminal": "pipes", "privileged": true }
  ]
}
